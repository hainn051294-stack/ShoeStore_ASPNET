@model List<Category>
@{
    ViewData["Title"] = "Thương hiệu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Danh sách thương hiệu (@Model.Count)</h5>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm thương hiệu</a>
</div>

<div class="admin-card">
    <table class="table admin-table">
        <thead><tr><th>#</th><th>Tên</th><th>Slug</th><th>Số sản phẩm</th><th>Thứ tự</th><th>Kích hoạt</th><th></th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>
                        <img src="~/images/brands/@(c.Slug).png" alt="@c.Name" class="brand-logo-sm"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='';" />
                        <i class="bi @c.Icon" style="display:none"></i>
                        <strong>@c.Name</strong>
                    </td>
                    <td>@c.Slug</td>
                    <td>@c.Products.Count</td>
                    <td>@c.DisplayOrder</td>
                    <td>
                        @if (c.IsActive)
                        {
                            <span class="badge bg-success">Hiện</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Ẩn</span>
                        }
                    </td>
                    <td class="text-nowrap">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa thương hiệu này?')">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
