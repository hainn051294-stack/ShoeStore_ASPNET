@model ApplicationUser
@{
    ViewData["Title"] = "Khách hàng " + Model.FullName;
    var totalSpent = Model.Orders
        .Where(o => o.Status != OrderStatus.Cancelled)
        .Sum(o => o.TotalAmount);
}

<div class="admin-card" style="max-width: 820px;">
    <h4>@Model.FullName</h4>
    <p class="text-muted mb-1">@Model.Email — @Model.PhoneNumber</p>
    <p class="text-muted">Địa chỉ: @Model.Address</p>
    <p>Tham gia từ <strong>@(Model.CreatedAt.ToString("dd/MM/yyyy"))</strong> — Tổng <strong>@Model.Orders.Count đơn</strong> — Chi tiêu <strong>@FormatHelper.Vnd(totalSpent)</strong></p>
    <hr />
    <h6>Lịch sử đơn hàng</h6>
    @if (Model.Orders.Count == 0)
    {
        <p class="text-muted">Chưa có đơn hàng nào.</p>
    }
    else
    {
        <table class="table admin-table">
            <thead><tr><th>Mã đơn</th><th>Ngày</th><th>Tổng tiền</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var o in Model.Orders.OrderByDescending(o => o.CreatedAt))
                {
                    <tr>
                        <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">@o.OrderCode</a></td>
                        <td>@o.CreatedAt:dd/MM/yyyy</td>
                        <td>@FormatHelper.Vnd(o.TotalAmount)</td>
                        <td><span class="badge @FormatHelper.StatusClass(o.Status)">@FormatHelper.StatusText(o.Status)</span></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <a asp-action="Index" class="btn btn-outline-secondary mt-3">← Danh sách khách hàng</a>
</div>
