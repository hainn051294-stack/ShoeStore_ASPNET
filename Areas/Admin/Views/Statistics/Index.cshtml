@{
    ViewData["Title"] = "Thống kê";
    var bestSellers = ViewBag.BestSellers;
    var topBrands = ViewBag.TopBrands;
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-label">Tổng doanh thu</span>
            <strong>@FormatHelper.Vnd((decimal)ViewBag.TotalRevenue)</strong>
            <i class="bi bi-currency-dollar"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-label">Tổng đơn hàng</span>
            <strong>@ViewBag.TotalOrders</strong>
            <i class="bi bi-receipt"></i>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-label">Trung bình 1 đơn</span>
            <strong>@FormatHelper.Vnd((decimal)ViewBag.AverageOrder)</strong>
            <i class="bi bi-graph-up"></i>
        </div>
    </div>
</div>

<div class="admin-card mb-4">
    <h5>Doanh thu 12 tháng năm @DateTime.Now.Year</h5>
    <canvas id="yearChart" height="110"></canvas>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="admin-card">
            <h5><i class="bi bi-trophy"></i> Top 10 sản phẩm bán chạy</h5>
            <table class="table admin-table">
                <thead><tr><th>#</th><th>Sản phẩm</th><th>SL bán</th><th>Doanh thu</th></tr></thead>
                <tbody>
                    @{ var rank = 1; }
                    @foreach (var b in bestSellers)
                    {
                        <tr>
                            <td>@(rank++)</td>
                            <td>@b.ProductName</td>
                            <td>@b.TotalQty</td>
                            <td>@FormatHelper.Vnd(b.TotalRevenue)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="admin-card">
            <h5><i class="bi bi-tags"></i> Thương hiệu được mua nhiều</h5>
            <canvas id="brandChart" height="220"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        new Chart(document.getElementById('yearChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartLabels)),
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ChartData)),
                    backgroundColor: 'rgba(37, 99, 235,.7)',
                    borderRadius: 6
                }]
            },
            options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        new Chart(document.getElementById('brandChart'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)topBrands).Select(x => (string)x.Brand).ToList())),
                datasets: [{
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((IEnumerable<dynamic>)topBrands).Select(x => (int)x.TotalQty).ToList())),
                    backgroundColor: ['#2563eb', '#38bdf8', '#f59e0b', '#10b981', '#3b82f6', '#ef4444', '#8b5cf6', '#14b8a6']
                }]
            }
        });
    </script>
}
