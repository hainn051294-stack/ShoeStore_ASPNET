@model List<Product>
@{
    ViewData["Title"] = "Sản phẩm";
    var categories = (List<Category>)ViewBag.Categories;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="q" value="@ViewBag.SearchTerm" class="form-control" placeholder="Tìm sản phẩm..." />
        <select name="categoryId" class="form-select">
            <option value="">Tất cả thương hiệu</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(ViewBag.CategoryFilter as int? == c.Id)">@c.Name</option>
            }
        </select>
        <button class="btn btn-outline-primary">Lọc</button>
    </form>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm sản phẩm</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table admin-table">
            <thead><tr><th>Ảnh</th><th>Tên</th><th>Thương hiệu</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><img src="@(p.MainImage ?? "/images/products/placeholder.svg")" class="admin-thumb" onerror="this.src='/images/products/placeholder.svg'" /></td>
                        <td>@p.Name</td>
                        <td>@p.Category.Name</td>
                        <td>
                            @if (p.IsOnSale)
                            {
                                <del class="text-muted small">@FormatHelper.Vnd(p.Price)</del>
                                <br />@FormatHelper.Vnd(p.DisplayPrice)
                            }
                            else
                            {
                                @FormatHelper.Vnd(p.Price)
                            }
                        </td>
                        <td>@p.Stock</td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã ẩn</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa sản phẩm này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
