@model ProductDetailViewModel
@{
    var p = Model.Product;
    var img = string.IsNullOrEmpty(p.MainImage) ? "/images/products/placeholder.svg" : p.MainImage;
    var sizes = (p.SizeOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var colors = (p.ColorOptions ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
}

<div class="container section">
    <nav><ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active">@p.Name</li>
    </ol></nav>

    <div class="row g-5 detail-row">
        <div class="col-lg-6">
            <img src="@img" alt="@p.Name" class="detail-img" id="mainImage" onerror="this.src='/images/products/placeholder.svg'" />
            @if (Model.Product.Images.Count > 1)
            {
                <div class="gallery-thumbs mt-3" id="galleryThumbs">
                    @foreach (var image in Model.Product.Images)
                    {
                        <img src="@image.Url" data-color="@image.Color" class="thumb"
                             onclick="setMainImage(this)" onerror="this.src='/images/products/placeholder.svg'" />
                    }
                </div>
            }
        </div>
        <div class="col-lg-6">
            <span class="card-brand">@p.Category.Name</span>
            <h1 class="detail-name">@p.Name</h1>
            <p class="text-muted">@p.ShortDescription</p>
            <div class="detail-price">
                @if (p.IsOnSale)
                {
                    <span class="price-new big">@FormatHelper.Vnd(p.DisplayPrice)</span>
                    <span class="price-old">@FormatHelper.Vnd(p.Price)</span>
                    <span class="badge-sale inline">-@(Math.Round((1 - p.SalePrice!.Value / p.Price) * 100))%</span>
                }
                else
                {
                    <span class="price-new big">@FormatHelper.Vnd(p.Price)</span>
                }
            </div>

            <p class="mt-2 @(p.InStock ? "text-success" : "text-danger")">
                <i class="bi @(p.InStock ? "bi-check-circle" : "bi-x-circle")"></i>
                @(p.InStock ? $"Còn {p.Stock} sản phẩm" : "Hết hàng")
            </p>

            <form asp-controller="Cart" asp-action="Add" method="post" id="addToCartForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@p.Id" />

                @if (colors.Length > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Màu sắc</label>
                        <div class="option-chips">
                            @foreach (var c in colors)
                            {
                                <label class="chip">
                                    <input type="radio" name="color" value="@c" checked="@c == colors[0]" />
                                    <span>@c</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                @if (sizes.Length > 0)
                {
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Kích cỡ (EU)</label>
                        <div class="option-chips">
                            @foreach (var s in sizes)
                            {
                                <label class="chip">
                                    <input type="radio" name="size" value="@s" checked="@s == sizes[0]" />
                                    <span>@s</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 align-items-center mb-3">
                    <label class="form-label fw-semibold mb-0">Số lượng</label>
                    <input type="number" name="quantity" value="1" min="1" max="@Math.Max(p.Stock, 1)" class="form-control qty-input" />
                </div>

                <button type="submit" class="btn btn-hero-primary btn-lg w-100" @(p.InStock ? "" : "disabled")>
                    <i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng
                </button>
            </form>

            <div class="detail-info mt-4">
                <div><i class="bi bi-truck"></i> Miễn phí giao hàng từ 2 triệu</div>
                <div><i class="bi bi-arrow-repeat"></i> Đổi trả trong 7 ngày</div>
                <div><i class="bi bi-shield-check"></i> Bảo hành chính hãng 6 tháng</div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-lg-6">
            <div class="detail-tab">
                <h4>Mô tả sản phẩm</h4>
                <p>@p.Description</p>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="detail-tab">
                <h4>Thông số</h4>
                <ul class="spec-list">
                    @foreach (var line in (p.Specifications ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <li>@line</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    @if (Model.RelatedProducts.Count > 0)
    {
        <div class="section-head mt-5">
            <h2>Sản phẩm liên quan</h2>
        </div>
        <div class="row g-4">
            @foreach (var rp in Model.RelatedProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="rp" />
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function setMainImage(el) {
            document.getElementById('mainImage').src = el.getAttribute('src');
            document.querySelectorAll('.gallery-thumbs .thumb').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
        }

        (function () {
            const thumbs = Array.from(document.querySelectorAll('#galleryThumbs .thumb'));
            const colorInputs = Array.from(document.querySelectorAll('#addToCartForm input[name="color"]'));
            if (thumbs.length === 0 || colorInputs.length === 0) return;

            function applyColor() {
                const selected = colorInputs.find(i => i.checked)?.value;
                thumbs.forEach(t => {
                    t.style.display = (!t.dataset.color || t.dataset.color === selected) ? '' : 'none';
                });
                // đổi ảnh chính sang ảnh đầu của màu đang chọn
                const first = thumbs.find(t => t.dataset.color === selected);
                if (first) {
                    const main = document.getElementById('mainImage');
                    if (main && first.getAttribute('src')) main.src = first.getAttribute('src');
                    thumbs.forEach(t => t.classList.remove('active'));
                    first.classList.add('active');
                }
            }

            colorInputs.forEach(i => i.addEventListener('change', applyColor));
            applyColor();
        })();

        document.getElementById('addToCartForm')?.addEventListener('submit', async function (e) {
            e.preventDefault();
            const form = e.target;
            const fd = new FormData(form);
            fd.append('__RequestVerificationToken', form.querySelector('[name="__RequestVerificationToken"]').value);
            const res = await fetch('@Url.Action("Add", "Cart")', { method: 'POST', body: fd });
            const data = await res.json();
            alert(data.message);
            if (data.success) {
                const badge = document.getElementById('cartBadge');
                if (badge && data.cartCount !== undefined) badge.textContent = data.cartCount;
                form.reset();
            }
        });
    </script>
}
