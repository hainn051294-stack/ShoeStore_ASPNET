@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container section">
    <h2 class="mb-4"><i class="bi bi-bag"></i> Giỏ hàng (@Model.Count sản phẩm)</h2>

    @if (Model.IsEmpty)
    {
        <div class="empty-state">
            <i class="bi bi-bag-x"></i>
            <p>Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-hero-primary">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-list">
                    @foreach (var item in Model.Items)
                    {
                        <div class="cart-item">
                            <img src="@(item.ProductImage ?? "/images/products/placeholder.svg")" alt="@item.ProductName" onerror="this.src='/images/products/placeholder.svg'" />
                            <div class="cart-item-info">
                                <a asp-controller="Product" asp-action="Details" asp-route-slug="">
                                    <strong>@item.ProductName</strong>
                                </a>
                                <small class="text-muted d-block">
                                    @(item.Color != null ? "Màu: " + item.Color : "")
                                    @(item.Size != null ? " — Size: " + item.Size : "")
                                </small>
                                <span class="price-new">@FormatHelper.Vnd(item.Price)</span>
                            </div>
                            <div class="cart-item-actions">
                                <form asp-action="Update" method="post" class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="@Math.Max(item.Stock, 1)" class="form-control qty-input" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-repeat"></i></button>
                                </form>
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@item.ItemId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-4">
                <div class="summary-card">
                    <h5>Tổng kết đơn hàng</h5>
                    <div class="summary-row"><span>Tạm tính</span><strong>@FormatHelper.Vnd(Model.SubTotal)</strong></div>
                    <div class="summary-row"><span>Phí giao hàng</span><strong>@(Model.ShippingFee == 0 ? "Miễn phí" : FormatHelper.Vnd(Model.ShippingFee))</strong></div>
                    <hr />
                    <div class="summary-row total"><span>Tổng cộng</span><strong class="text-gradient">@FormatHelper.Vnd(Model.Total)</strong></div>
                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-hero-primary w-100 mt-3">Thanh toán <i class="bi bi-arrow-right"></i></a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-hero-outline w-100 mt-2">Tiếp tục mua sắm</a>
                </div>
            </div>
        </div>
    }
</div>
