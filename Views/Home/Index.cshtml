@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center hero-row">
            <div class="col-lg-6 hero-text">
                <span class="hero-badge">🔥 Sale up to 30% — sneaker chính hãng</span>
                <h1 class="hero-title"><span class="text-gradient">Nâng tầm phong cách</span><br><span class="text-gradient">cùng sneaker</span></h1>
                <p class="hero-sub">Bộ sưu tập giày chính hãng Nike, Adidas, Jordan, New Balance... Giá tốt nhất thị trường, bảo hành 6 tháng.</p>
                <div class="hero-actions">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-hero-primary">Mua ngay</a>
                    <a asp-controller="Home" asp-action="About" class="btn btn-hero-outline">Về SneakerHub</a>
                </div>
                <div class="hero-stats">
                    <div><strong>18+</strong><span>Mẫu giày hot</span></div>
                    <div><strong>8</strong><span>Thương hiệu</span></div>
                    <div><strong>1k+</strong><span>Khách hàng</span></div>
                </div>
            </div>
            <div class="col-lg-6 text-center hero-visual">
                <div class="hero-slider" id="heroSlider">
                    <div class="hero-slider-track" id="sliderTrack">
                        @for (var i = 1; i <= 6; i++)
                        {
                            <img src="~/images/banners/banner-@(i).png" alt="Banner SneakerHub @i"
                                 class="hero-slide" loading="@(i == 1 ? "eager" : "lazy")" />
                        }
                    </div>
                    <button type="button" class="hero-slide-nav prev" id="slidePrev" aria-label="Banner trước">&#8249;</button>
                    <button type="button" class="hero-slide-nav next" id="slideNext" aria-label="Banner sau">&#8250;</button>
                    <div class="hero-slider-dots">
                        @for (var i = 1; i <= 6; i++)
                        {
                            <button type="button" class="hero-dot @(i == 1 ? "active" : "")" data-index="@(i - 1)" aria-label="Chọn banner @i"></button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="promo-marquee">
    <div class="marquee-track">
        @for (var i = 0; i < 2; i++)
        {
            <span>🚚 Miễn phí giao hàng từ 2 triệu &nbsp;•&nbsp; 🎁 Quà tặng khi mua giày Nike &nbsp;•&nbsp; 💳 COD toàn quốc &nbsp;•&nbsp; 🔄 Đổi trả trong 7 ngày &nbsp;•&nbsp;</span>
        }
    </div>
</div>

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Thương hiệu nổi bật</h2>
            <p>Chọn thương hiệu yêu thích của bạn</p>
        </div>
        <div class="brand-grid">
            @foreach (var c in Model.Categories)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@c.Id" class="brand-card brand-only" title="@c.Name">
                    <img src="~/images/brands/@(c.Slug).png" alt="@c.Name" class="brand-logo"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='';" />
                    <i class="bi @c.Icon" style="display:none"></i>
                    <span class="visually-hidden">@c.Name</span>
                </a>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Sản phẩm nổi bật</h2>
            <a asp-controller="Product" asp-action="Index" class="see-all">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            @foreach (var p in Model.FeaturedProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
    </div>
</section>

<section class="section section-alt">
    <div class="container">
        <div class="section-head">
            <h2>Mới cập nhật</h2>
            <a asp-controller="Product" asp-action="Index" asp-route-sortOrder="newest" class="see-all">Xem tất cả <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            @foreach (var p in Model.NewestProducts)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <partial name="_ProductCard" model="p" />
                </div>
            }
        </div>
    </div>
</section>

<script>
    (function () {
        const track = document.getElementById('sliderTrack');
        const slides = Array.from(document.querySelectorAll('#sliderTrack .hero-slide'));
        if (!track || slides.length === 0) return;
        const dots = Array.from(document.querySelectorAll('.hero-dot'));
        let cur = 0, timer = null;
        function show(i) {
            cur = (i + slides.length) % slides.length;
            track.style.transform = 'translateX(-' + (cur * 100) + '%)';
            dots.forEach((d, k) => d.classList.toggle('active', k === cur));
        }
        function next() { show(cur + 1); }
        function restart() { clearInterval(timer); timer = setInterval(next, 4000); }
        document.getElementById('slideNext')?.addEventListener('click', () => { next(); restart(); });
        document.getElementById('slidePrev')?.addEventListener('click', () => { show(cur - 1); restart(); });
        dots.forEach(d => d.addEventListener('click', () => { show(+d.dataset.index); restart(); }));
        show(0);
        restart();
    })();
</script>
