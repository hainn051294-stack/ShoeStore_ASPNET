@{
    ViewData["Title"] = "Về SneakerHub";
}

<div class="container section">
    <div class="section-head">
        <h2>Về SneakerHub</h2>
        <p>Câu chuyện của chúng tôi</p>
    </div>
    <div class="row g-4 align-items-center">
        <div class="col-lg-6">
            <h3 class="text-gradient">Sneaker chính hãng cho người yêu giày Việt</h3>
            <p class="text-muted">SneakerHub được thành lập bởi những người đam mê sneaker, với sứ mệnh mang đến các mẫu giày chính hãng từ Nike, Adidas, Jordan, New Balance, Vans, Converse... với mức giá hợp lý nhất.</p>
            <p class="text-muted">Chúng tôi cam kết 100% sản phẩm chính hãng, đầy đủ hộp giấy, tem nhãn, bảo hành 6 tháng và hỗ trợ đổi trả trong 7 ngày.</p>
        </div>
        <div class="col-lg-6 text-center">
            <img src="~/images/products/new-balance-990v5-grey/1.jpg" alt="SneakerHub" class="hero-img float-anim" />
        </div>
    </div>
    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="brand-card big"><i class="bi bi-patch-check"></i><h5>100% Chính hãng</h5><p class="text-muted mb-0">Nguồn hàng rõ ràng, đầy đủ phụ kiện</p></div>
        </div>
        <div class="col-md-4">
            <div class="brand-card big"><i class="bi bi-truck"></i><h5>Giao hàng nhanh</h5><p class="text-muted mb-0">COD toàn quốc, miễn phí từ 2 triệu</p></div>
        </div>
        <div class="col-md-4">
            <div class="brand-card big"><i class="bi bi-headset"></i><h5>Hỗ trợ 24/7</h5><p class="text-muted mb-0">Hotline 1900 1234 luôn sẵn sàng</p></div>
        </div>
    </div>
</div>
