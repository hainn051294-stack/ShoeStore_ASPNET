<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SneakerHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Sora:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg site-nav">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-lightning-charge-fill brand-icon"></i> Sneaker<span class="text-gradient">Hub</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                Thương hiệu
                            </a>
                            <div class="dropdown-menu mega-menu">
                                @await Component.InvokeAsync("CategoryMenu")
                            </div>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="About">Về SneakerHub</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a></li>
                    </ul>
                    <form class="search-box" asp-controller="Product" asp-action="Index" method="get">
                        <input type="search" name="q" value="@ViewBag.SearchTerm" placeholder="Tìm giày..." />
                        <button type="submit"><i class="bi bi-search"></i></button>
                    </form>
                    <ul class="navbar-nav nav-actions ms-lg-2">
                        <li class="nav-item">
                            @await Component.InvokeAsync("CartCount")
                        </li>
                        @if (User.Identity!.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-link" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Index"><i class="bi bi-receipt"></i> Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i> Hồ sơ</a></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Quản trị</a></li>
                                    }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Đăng nhập</a></li>
                            <li class="nav-item"><a class="btn btn-nav-register" asp-controller="Account" asp-action="Register">Đăng ký</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        <!-- ALERTS -->
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5><i class="bi bi-lightning-charge-fill"></i> SneakerHub</h5>
                    <p class="text-muted">Cửa hàng giày sneaker chính hãng — cập nhật xu hướng mới nhất với giá tốt nhất.</p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Giới thiệu</h6>
                    <a asp-controller="Home" asp-action="About">Về SneakerHub</a>
                    <a asp-controller="Home" asp-action="Contact">Liên hệ</a>
                    <a asp-controller="Home" asp-action="Privacy">Chính sách</a>
                </div>
                <div class="col-6 col-lg-3">
                    <h6>Hỗ trợ khách hàng</h6>
                    <span class="text-muted">Hotline: 1900 1234</span>
                    <span class="text-muted">Email: support@sneakerhub.vn</span>
                    <span class="text-muted">Giao hàng COD toàn quốc</span>
                </div>
                <div class="col-lg-3">
                    <h6>Địa chỉ</h6>
                    <span class="text-muted">273 An Dương Vương, Quận 5, TP. Hồ Chí Minh</span>
                </div>
            </div>
            <hr class="footer-line" />
            <p class="text-center text-muted mb-0">&copy; @DateTime.Now.Year SneakerHub — ASP.NET Core MVC (.NET 8)</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
