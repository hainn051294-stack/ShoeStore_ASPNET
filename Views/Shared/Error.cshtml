@model ErrorViewModel
@{
    ViewData["Title"] = "Lỗi";
}

<div class="container py-5 text-center">
    <h1 class="display-1 text-gradient">Oops!</h1>
    <h2 class="mb-3">Đã có lỗi xảy ra</h2>
    <p class="text-muted mb-4">Chúng tôi xin lỗi vì sự bất tiện này. Vui lòng thử lại sau.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-hero-primary">Về trang chủ</a>
</div>
