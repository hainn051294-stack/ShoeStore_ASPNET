@model List<Order>
@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container section">
    <h2 class="mb-4"><i class="bi bi-receipt"></i> Đơn hàng của tôi</h2>

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <i class="bi bi-receipt-cutoff"></i>
            <p>Bạn chưa có đơn hàng nào.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-hero-primary">Mua sắm ngay</a>
        </div>
    }
    else
    {
        <div class="order-list">
            @foreach (var order in Model)
            {
                <a asp-action="Details" asp-route-id="@order.Id" class="order-row">
                    <div>
                        <strong>@order.OrderCode</strong>
                        <small class="text-muted d-block">@order.CreatedAt:dd/MM/yyyy HH:mm — @order.Details.Count sản phẩm</small>
                    </div>
                    <div class="text-end">
                        <span class="badge @FormatHelper.StatusClass(order.Status)">@FormatHelper.StatusText(order.Status)</span>
                        <strong class="d-block mt-1">@FormatHelper.Vnd(order.TotalAmount)</strong>
                    </div>
                </a>
            }
        </div>
    }
</div>
