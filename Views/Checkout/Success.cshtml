@model Order
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container section text-center">
    <div class="success-box">
        <i class="bi bi-check-circle-fill success-icon"></i>
        <h2>Đặt hàng thành công! 🎉</h2>
        <p class="text-muted">Mã đơn hàng của bạn là:</p>
        <h3 class="order-code">@Model.OrderCode</h3>
        <p class="text-muted">Tổng thanh toán: <strong>@FormatHelper.Vnd(Model.TotalAmount)</strong> — @FormatHelper.StatusText(Model.Status)</p>
        <div class="d-flex gap-2 justify-content-center mt-4">
            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-hero-primary">Xem đơn hàng</a>
            <a asp-controller="Product" asp-action="Index" class="btn btn-hero-outline">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>
